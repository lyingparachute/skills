#!/usr/bin/env python3
# Check that ExecPlans use the strict milestone format of TEMPLATE.md.
#
# Rules per plan file:
#   1. Exactly one level-2 heading starts with "## Milestones".
#   2. Every milestone is a heading "### Milestone N - <title>".
#   3. Milestones are numbered 1..N in document order with no gaps.
#   4. Every milestone heading sits under the "## Milestones" section.
#   5. No other milestone form is left: no other milestone-like heading
#      anywhere, and inside "## Milestones" no paragraph or list item that
#      opens like a milestone ("Milestone 2:", "**Milestone 2 Title**",
#      "**M2.**", "M2,", "1. ..."). A bare "Milestone 2 Title" line counts
#      before the first heading, and after it only for a number no heading has
#      opened yet; "Milestone 1 needs X." under a later heading is prose.
#   6. A "Status: ready" line whose note says the critic gate is still open
#      fails (no critic round, zero critic rounds, a critic or numbered round
#      directly marked pending, awaited or not run, unreviewed, not yet
#      reviewed, TODO/TBD/WIP): that plan is a draft. "Round 2 fixes not
#      re-reviewed" passes, since the two-round cap allows it, and so do owner
#      and other reviews ("owner review pending") and a recorded owner
#      override ("owner instructed", "owner waived").
#   7. With --since REF: at most 3% of the words in the file at REF are gone,
#      so a format conversion cannot silently drop content.
# Fenced code blocks are ignored.
#
# Usage: check-plan-format [--since REF] PLAN_FILE...
# Exit 1 when any file fails, 2 on bad usage.
import re
import subprocess
import sys
from collections import Counter

MILESTONE_HEADING = re.compile(r"^### Milestone (\d+) - \S.*$")
OLD_FORM = re.compile(
    r"^(\*\*)?(Milestone|Task|Step|Phase)[ \t]+(M?\d+[a-z]?|[A-Z])([ \t]*[-.:,)–—]|\*\*)"
    r"|^\*\*(Milestone|Task|Step|Phase)[ \t]+(M?\d+[a-z]?|[A-Z])[ \t]+\w"
    r"|^(\*\*)?M\d+[a-z]?(\*\*)?[.:,)]"
    r"|^#{1,6} +(Milestone|M|Task|Step|Phase) ?\d"
)
BARE_FORM = re.compile(r"^(Milestone|Task|Step|Phase)[ \t]+(M?\d+[a-z]?|[A-Z])[ \t]+\w")
FENCE = re.compile(r"^[ \t]*(```|~~~)")
WORD = re.compile(r"[A-Za-z0-9_]+")
MAX_REMOVED_SHARE = 0.03
STATUS_LINE = re.compile(r"^Status:\s*(.*)$")
OPEN_GATE_PATTERNS = [
    r"todo",
    r"tbd",
    r"wip",
    r"unreviewed",
    r"not (?:yet )?(?:critic-)?reviewed",
    r"no critic (?:round|pass|review)s?",
    r"(?:zero|0) critic rounds?",
    r"ha(?:s|ve) not had a critic",
    r"critic gate not run",
    r"no critic yet",
    r"needs? (?:a )?critic",
    r"(?:(?:first|second) )?(?:critic|round[- ]\d+)(?: round(?: \d+)?| critic)? \(?(?:is |still )?(?:pending|awaiting|not yet run|not run)",
    r"(?:pending|awaiting|waiting for) (?:a |the )?(?:(?:first|second) )?(?:round[- ]\d+ )?critic",
]
OWNER_OVERRIDE = re.compile(r"\bowner (?:instructed|waived|dismissed|set it ready|told)\b", re.IGNORECASE)
OPEN_GATE = re.compile("|".join(rf"\b{x}\b" for x in OPEN_GATE_PATTERNS), re.IGNORECASE)


def is_unopened_bare_milestone(bare, nums):
    if not bare:
        return False
    if not nums:
        return True
    number = re.match(r"M?(\d+)", bare.group(2))
    return bare.group(1) == "Milestone" and number is not None and int(number.group(1)) > max(nums)


def words(text):
    return Counter(w.lower() for w in WORD.findall(text))


def status_errors(text):
    infence = False
    for i, line in enumerate(text.splitlines(), 1):
        if FENCE.match(line):
            infence = not infence
            continue
        if infence:
            continue
        m = STATUS_LINE.match(line)
        if not m:
            continue
        note = m.group(1)
        if not re.match(r"ready\b", note):
            return []
        if OWNER_OVERRIDE.search(note):
            return []
        gate = OPEN_GATE.search(note)
        return [f'{i}: Status says ready but the gate is open ("{gate.group(0)}"); use draft'] if gate else []
    return []


def format_errors(text):
    errs = []
    infence = False
    section = ""
    milestone_sections = 0
    nums = []
    for i, line in enumerate(text.splitlines(), 1):
        if FENCE.match(line):
            infence = not infence
            continue
        if infence:
            continue
        if line.startswith("## "):
            section = line
            if line.startswith("## Milestones"):
                milestone_sections += 1
            continue
        in_milestones = section.startswith("## Milestones")
        m = MILESTONE_HEADING.match(line)
        if m:
            nums.append(int(m.group(1)))
            if not in_milestones:
                errs.append(f"{i}: milestone heading outside '## Milestones'")
            continue
        if OLD_FORM.match(line) and (in_milestones or line.startswith("#")):
            errs.append(f"{i}: other milestone form: {line[:70]}")
        if in_milestones and is_unopened_bare_milestone(BARE_FORM.match(line), nums):
            errs.append(f"{i}: other milestone form: {line[:70]}")
        if in_milestones and not nums and re.match(r"^\d+\.\s", line):
            errs.append(f"{i}: numbered list item where milestone headings belong: {line[:60]}")
    if milestone_sections != 1:
        errs.append(f"expected one '## Milestones' section, found {milestone_sections}")
    if not nums:
        errs.append("no '### Milestone N - <title>' heading")
    elif nums != list(range(1, len(nums) + 1)):
        errs.append(f"milestones not numbered 1..N in order: {nums}")
    return errs


def content_loss(path, text, ref):
    shown = subprocess.run(["git", "show", f"{ref}:{path}"], capture_output=True, text=True)
    if shown.returncode != 0:
        return []
    before, after = words(shown.stdout), words(text)
    removed = sum((before - after).values())
    total = max(1, sum(before.values()))
    if removed / total > MAX_REMOVED_SHARE:
        return [f"content loss since {ref}: {removed} of {total} words removed"]
    return []


def main(argv):
    since = None
    if argv[:1] == ["--since"]:
        if len(argv) < 3:
            print("usage: check-plan-format [--since REF] PLAN_FILE...", file=sys.stderr)
            return 2
        since, argv = argv[1], argv[2:]
    if not argv:
        print("usage: check-plan-format [--since REF] PLAN_FILE...", file=sys.stderr)
        return 2
    failing = 0
    for path in argv:
        text = open(path, encoding="utf-8").read()
        errs = format_errors(text) + status_errors(text)
        if since:
            errs += content_loss(path, text, since)
        if errs:
            failing += 1
            print(f"FAIL {path}")
            for e in errs[:8]:
                print(f"     {e}")
    print(f"{len(argv) - failing} ok, {failing} failing")
    return 1 if failing else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
