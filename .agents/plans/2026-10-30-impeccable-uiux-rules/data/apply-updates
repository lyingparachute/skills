#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ledger_rows import LEDGER, OUTCOMES

UPDATES = Path(__file__).resolve().parent / "updates"


def load_updates(paths):
    updates, problems = {}, []
    for path in paths:
        for number, line in enumerate(path.read_text().splitlines(), 1):
            if not line.strip():
                continue
            cells = line.split("\t")
            if len(cells) != 4:
                problems.append(f"{path.name}:{number}: needs 4 tab-separated cells")
                continue
            row_id, outcome, destination, anchor = (c.strip() for c in cells)
            if outcome not in OUTCOMES - {"pending", "out-of-scope"}:
                problems.append(f"{path.name}:{number}: outcome {outcome}")
            if "|" in destination + anchor:
                problems.append(f"{path.name}:{number}: '|' in destination or anchor")
            if row_id in updates:
                problems.append(f"{path.name}:{number}: {row_id} also in {updates[row_id][0]}")
            updates[row_id] = (path.name, outcome, destination, anchor)
    return updates, problems


def main():
    paths = [UPDATES / name for name in sys.argv[1:]] or sorted(UPDATES.glob("*.tsv"))
    updates, problems = load_updates(paths)
    out, applied = [], set()
    for line in LEDGER.read_text().splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if line.startswith("| ") and len(cells) == 6 and cells[0] in updates:
            _, outcome, destination, anchor = updates[cells[0]]
            cells[3:6] = [outcome, destination, anchor]
            line = "| " + " | ".join(cells) + " |"
            applied.add(cells[0])
        out.append(line)
    problems += [f"unknown id {i}" for i in sorted(set(updates) - applied)]
    if problems:
        print("\n".join(f"FAIL {p}" for p in problems))
        sys.exit(1)
    LEDGER.write_text("\n".join(out) + "\n")
    print(f"applied {len(applied)} updates from {len(paths)} files")


if __name__ == "__main__":
    main()
