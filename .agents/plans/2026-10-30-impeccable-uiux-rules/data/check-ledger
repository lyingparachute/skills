#!/usr/bin/env python3
import argparse
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ledger_rows import (EXPECTED_NON_COVERED, EXPECTED_PARSED, OUTCOMES, gap_rows,
                         non_covered, read_ledger)

PLAN = Path(__file__).resolve().parent.parent / "plan.md"
REPO = PLAN.parents[3]
REFERENCE = REPO / "impeccable" / "reference"
BASELINE = "4280335"
FILE_DESTINATIONS = {
    f"details/{name}.md" for name in [
        "interaction", "gestures", "color-values", "product-patterns", "charts", "landing",
        "macos", "ai-interface", "mobile", "motion", "typography", "surfaces"]
}
EXTERNAL_DESTINATIONS = {"dataviz"}
RENAMES = {"details/mobile.md": "details/mobile-web.md"}
HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*$")
FENCE = re.compile(r"^\s*(```|~~~)")
REJECTION_REASON = re.compile(r"\b[CIDA]\d+\b|[\w./-]+\.md:\d+|D3#\d+")
STOPWORDS = {"the", "a", "an", "and", "or", "of", "to", "in", "on", "for", "with", "is", "are", "it"}


def fail(problems, summary):
    for problem in problems:
        print(f"FAIL {problem}")
    if problems:
        sys.exit(1)
    print(summary)


def decision_rows():
    text = PLAN.read_text()
    start = text.index("3. **Conflict resolutions.**")
    end = text.index("4. **Pointer lines.**", start)
    return {int(n) for n in re.findall(r"^\| (\d+) \|", text[start:end], re.M)}


def assignment_problems(entries):
    rows = gap_rows()
    todo = non_covered(rows)
    problems = []
    if len(rows) != EXPECTED_PARSED or len(todo) != EXPECTED_NON_COVERED:
        problems.append(f"parsed {len(rows)}/{len(todo)}, expected {EXPECTED_PARSED}/{EXPECTED_NON_COVERED}")
    ids = [e["id"] for e in entries]
    duplicates = sorted({i for i in ids if ids.count(i) > 1})
    expected = {r["id"] for r in todo}
    problems += [f"duplicate id {i}" for i in duplicates]
    problems += [f"missing id {i}" for i in sorted(expected - set(ids))]
    problems += [f"extra id {i}" for i in sorted(set(ids) - expected)]
    known_decisions = decision_rows()
    by_id = {r["id"]: r for r in todo}
    for e in entries:
        source = by_id.get(e["id"])
        if source and (e["status"] != source["status"] or e["rule"] != source["rule"].replace("|", "/")):
            problems.append(f"{e['id']}: status or rule differs from the gap table")
        if (e["status"] == "OUT-OF-SCOPE") != (e["outcome"] == "out-of-scope"):
            problems.append(f"{e['id']}: out-of-scope outcome must match OUT-OF-SCOPE status")
        if e["outcome"] == "out-of-scope" and (e["destination"] or e["anchor"]):
            problems.append(f"{e['id']}: out-of-scope row carries a destination or anchor")
        if e["outcome"] == "rejected" and not REJECTION_REASON.search(e["destination"]):
            problems.append(f"{e['id']}: rejected without a research id, file:line, or D3#n")
        if e["outcome"] not in OUTCOMES:
            problems.append(f"{e['id']}: unknown outcome {e['outcome']}")
        if e["destination"] == "unassigned":
            problems.append(f"{e['id']}: unassigned")
        if e["outcome"] == "pending" and destination_file(e) not in FILE_DESTINATIONS:
            problems.append(f"{e['id']}: pending on non-plan file {e['destination']}")
        if e["status"] == "CONFLICT":
            cited = {int(n) for n in re.findall(r"D3#(\d+)", e["destination"])}
            if not cited or not cited <= known_decisions:
                problems.append(f"{e['id']}: CONFLICT without a valid D3#n")
    return problems


def destination_file(entry):
    return re.sub(r"\s*D3#\d+.*$", "", entry["destination"]).split("#", 1)[0].strip()


def destination_heading(entry):
    target = re.sub(r"\s*D3#\d+.*$", "", entry["destination"]).strip()
    return target.split("#", 1)[1].strip() if "#" in target else ""


def anchor_shape_ok(anchor):
    words = anchor.split()
    has_digit = any(ch.isdigit() for ch in anchor)
    has_content = has_digit or any(len(w) >= 4 and w.lower() not in STOPWORDS for w in words)
    return has_content and (len(words) >= 3 or (len(words) >= 2 and has_digit))


def section_lines(path, heading):
    lines = path.read_text().splitlines()
    headings, fenced = [], False
    for index, line in enumerate(lines):
        if FENCE.match(line):
            fenced = not fenced
        elif not fenced and (match := HEADING.match(line)):
            headings.append((index, len(match.group(1)), match.group(2)))
    for position, (start, level, text) in enumerate(headings):
        if text.lower() == heading.lower():
            end = next((i for i, lvl, _ in headings[position + 1:] if lvl <= level), len(lines))
            return list(range(start + 1, end)), lines
    return None, lines


def require_baseline():
    found = subprocess.run(["git", "cat-file", "-e", f"{BASELINE}^{{commit}}"], cwd=REPO, capture_output=True)
    if found.returncode != 0:
        sys.exit(f"baseline commit {BASELINE} is not in this repository")


def new_line_numbers(relative):
    current = f"impeccable/reference/{relative}"
    baseline = f"impeccable/reference/{RENAMES.get(relative, relative)}"
    tracked = subprocess.run(["git", "cat-file", "-e", f"{BASELINE}:{baseline}"],
                             cwd=REPO, capture_output=True).returncode == 0
    if not tracked:
        return None
    diff = subprocess.run(["git", "diff", "-U0", "-M", BASELINE, "--", baseline, current],
                          cwd=REPO, capture_output=True, text=True, check=True).stdout
    added = set()
    for hunk in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", diff, re.M):
        start, count = int(hunk.group(1)), int(hunk.group(2) or 1)
        added.update(range(start - 1, start - 1 + count))
    return added


def entry_problems(entry):
    if entry["outcome"] == "pending":
        return [f"{entry['id']}: pending"]
    if entry["outcome"] not in ("landed", "merged"):
        return []
    if entry["outcome"] == "merged" and destination_file(entry) in EXTERNAL_DESTINATIONS:
        return []
    relative, heading, anchor = destination_file(entry), destination_heading(entry), entry["anchor"]
    if not heading or not anchor_shape_ok(anchor):
        return [f"{entry['id']}: needs path#Heading and an anchor of 3+ words (2 with a digit)"]
    path = REFERENCE / relative
    if not path.exists():
        return [f"{entry['id']}: {relative} does not exist"]
    indexes, lines = section_lines(path, heading)
    if indexes is None:
        return [f"{entry['id']}: heading '{heading}' not in {relative}"]
    if entry["outcome"] == "landed":
        new = new_line_numbers(relative)
        if new is not None:
            indexes = [i for i in indexes if i in new]
    if not any(anchor.lower() in lines[i].lower() for i in indexes):
        where = "new lines of " if entry["outcome"] == "landed" else ""
        return [f"{entry['id']}: anchor '{anchor}' not in {where}{relative}#{heading}"]
    return []


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--assignment", action="store_true")
    parser.add_argument("--dest", action="append", default=[], choices=sorted(FILE_DESTINATIONS))
    args = parser.parse_args()
    require_baseline()
    entries = read_ledger()

    if args.assignment:
        unassigned = sum(e["destination"] == "unassigned" for e in entries)
        problems = assignment_problems(entries)
        fail(problems, f"assignment ok: {len(entries)} rows, {unassigned} unassigned, 0 conflicts without D3")
        return

    if args.dest:
        chosen = [e for e in entries if destination_file(e) in args.dest]
        problems = [f"--dest {d} matches no ledger row" for d in args.dest
                    if not any(destination_file(e) == d for e in chosen)]
        problems += [p for e in chosen for p in entry_problems(e)]
        fail(problems, f"dest ok: {len(chosen)} rows, 0 pending, all anchors found")
        return

    problems = assignment_problems(entries) + [p for e in entries for p in entry_problems(e)]
    fail(problems, f"ledger ok: parsed {EXPECTED_PARSED}, ledger {len(entries)}, 0 pending, all anchors found")


if __name__ == "__main__":
    main()
